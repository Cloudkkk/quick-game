config_version=5

[application]
config/name="Estate Rise · 街区大亨"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=820
window/size/viewport_width.web=600
window/size/viewport_height.web=480
window/size/window_width_override=1200
window/size/window_height_override=820
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.56, 0.64, 0.23, 1)
